{
  "name": "urd-contract",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist/",
    "ts/",
    "message.schema.json",
    "message.go",
    "event.schema.json",
    "event.go",
    "constants.go",
    "subject.go",
    "Makefile",
    "go.mod",
    "docs/"
  ],
  "exports": {
    "./message": {
      "types": "./dist/message.d.ts",
      "default": "./dist/message.js"
    },
    "./event": {
      "types": "./dist/event.d.ts",
      "default": "./dist/event.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "verify": "make verify"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3"
  }
}
